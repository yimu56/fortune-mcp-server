# ---------------------------------------------------------------------------
# Fortune 记账 MCP Server 配置样例
# 复制为 .env 后按实际环境修改：
#     cp .env.example .env && vi .env
# systemd 部署时该文件被安装为 /etc/fortune-mcp.env
# ---------------------------------------------------------------------------

# ===== 记账系统（下游业务系统）=====
FORTUNE_BASE_URL=http://fortune.example.com:46031/prod-api
FORTUNE_USERNAME=CHANGE_ME
FORTUNE_PASSWORD=CHANGE_ME
# 已加密密码（抓包回放用；有明文密码时忽略）
# FORTUNE_ENCRYPTED_PASSWORD=
# 直接指定 JWT（跳过登录，调试用）
# FORTUNE_TOKEN=
# 关闭 token 缓存（默认开启，缓存在 FORTUNE_TOKEN_CACHE_DIR）
# FORTUNE_TOKEN_CACHE=0
FORTUNE_TOKEN_CACHE_DIR=/var/lib/fortune-mcp
FORTUNE_HTTP_TIMEOUT=20

# ===== MCP 服务本身 =====
MCP_HOST=0.0.0.0
MCP_PORT=18088
MCP_PATH=/mcp
# 必填：企业版连接器里要填同一个 Bearer Token
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# 会话空闲回收（秒）
MCP_SESSION_TTL=3600
# 打印异常堆栈，排障时开
MCP_DEBUG=0
# 允许调用方用 X-Fortune-Username / X-Fortune-Password 头覆盖账号（多用户共用一个连接器时开）
FORTUNE_ALLOW_HEADER_CRED=0

# ===== 可选：服务自身启用 HTTPS（前面没有 nginx 时才需要）=====
# MCP_TLS_CERT=/etc/fortune-mcp/server.crt
# MCP_TLS_KEY=/etc/fortune-mcp/server.key
